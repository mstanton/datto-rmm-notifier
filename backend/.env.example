# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datto_rmm_notifier
DB_USER=postgres
DB_PASSWORD=your_db_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Datto RMM API Configuration
DATTO_API_URL=https://pinotage-api.centrastage.net
DATTO_API_KEY=your_api_key
DATTO_API_SECRET=your_api_secret

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=30m

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_NAME=Datto RMM Alerts
SMTP_FROM_EMAIL=alerts@example.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Alert Polling Configuration
POLLING_INTERVAL_MINUTES=5
ALERT_RETENTION_DAYS=90

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
DATTO_RATE_LIMIT_THRESHOLD=540

# Notification Configuration
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=60000
SMS_RATE_LIMIT_PER_CLIENT=10

# Support Contact Information
SUPPORT_PHONE=+1-555-0100
SUPPORT_EMAIL=support@example.com
PORTAL_URL=https://alerts.example.com
