# Application
NODE_ENV=production
PORT=3000
FRONTEND_PORT=5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datto_rmm_notifier
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Datto RMM API Configuration
DATTO_API_URL=https://pinotage-api.centrastage.net
DATTO_API_KEY=your_datto_api_key_here
DATTO_API_SECRET_KEY=your_datto_secret_key_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Datto RMM Alerts <alerts@example.com>

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Support Contact Information
SUPPORT_PHONE=555-0100
SUPPORT_EMAIL=support@example.com

# Application Settings
CORS_ORIGIN=*
ENABLE_POLLING=true
LOG_LEVEL=info
LOG_DIR=logs

# Frontend API URL
VITE_API_URL=http://localhost:3000/api
